{
  "manifest_version": 3,
  "name": "Chicago Public Library Availability Checker",
  "version": "1.0.0",
  "description": "Check book availability at Chicago Public Library branches from Excel or CSV files.",
  "action": {
    "default_title": "Open Library Checker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://gateway.bibliocommons.com/*",
    "https://data.cityofchicago.org/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
