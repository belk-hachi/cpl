{
  "manifest_version": 3,
  "name": "CPL Stock Check",
  "version": "2.0.0",
  "description": "Check whether a Chicago Public Library branch already owns the books on a spreadsheet.",
  "action": {
    "default_title": "Open Stock check"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://gateway.bibliocommons.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}